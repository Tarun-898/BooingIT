  <!-- Chatbot UI -->
<div id="chatbot-container">
  <div id="chat-header">Hotel Chatbot 🤖</div>
  <div id="chat-body"></div>
  <div id="chat-input-area">
    <input type="text" id="chat-input" placeholder="Type your message..." />
    <button onclick="sendMessage()">Send</button>
  </div>
</div>

<script>
  const hotelId = "<%= listData._id %>";
  const hotelPrice = <%= listData.price %>;

  async function sendMessage() {
    const input = document.getElementById("chat-input");
    const message = input.value.trim();
    if (!message) return;

    const chatBody = document.getElementById("chat-body");
    chatBody.innerHTML += `<div class="user"><b>You:</b> ${message}</div>`;

    const res = await fetch(`/chatbot/bargain`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message, hotelId, hotelPrice }),
    });

    const data = await res.json();
    chatBody.innerHTML += `<div class="bot"><b>Bot:</b> ${data.reply}</div>`;
    input.value = "";
    chatBody.scrollTop = chatBody.scrollHeight;
  }
</script>

<link rel="stylesheet" href="/css/chatbot.css">

</body>

